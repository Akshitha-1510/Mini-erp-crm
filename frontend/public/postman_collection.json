            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID\",\n  \"status\": \"Confirmed\",\n  \"items\": [\n    { \"productId\": \"PRODUCT_ID_1\", \"quantity\": 2 },\n    { \"productId\": \"PRODUCT_ID_2\", \"quantity\": 5 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/challans", "host": ["{{baseUrl}}"], "path": ["api", "challans"] }
